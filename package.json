{
  "name": "sign-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite --port 5190 --strictPort --host",
    "build": "tsc --noEmit && vite build",
